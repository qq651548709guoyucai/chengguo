# ========= 熬夜看短剧 · 服务端配置 =========
# 改完保存后，重启服务生效（重启命令见下面）

# 数据源开关（二选一，别都开）
#   0 = 苹果CMS稳定源（默认，整部剧合成1个视频，稳定能播，无分集）
#   1 = 红果官方API（榜单发现 + 真实分集 + 红果取址，真·一集一集）
# 注意：红果取址在部分服务器出口IP会被风控导致黑屏，若开了黑屏就改回 0
HG_FEED=0

# 稳定源开关（HG_FEED=1 时本项自动失效）
STABLE_FEED=1

# 服务端口（默认 3002）
PORT=3002

# 管理员初始密码（仅首次启动创建 admin 时生效，改完记得改密码）
# ADMIN_PASSWORD=admin123456

# 红果接口地址覆盖（一般不用动）
# OHG_API_ORIGIN=https://api5-normal-sinfonlinea.fqnovel.com

# ========= 重启服务的方法 =========
# 如果你是用 PM2 跑的：  pm2 restart 服务名
# 如果是 nohup/node 跑的：先 Ctrl+C 停掉，再执行 node server.mjs
# 如果是宝塔/面板：在进程管理里点重启
