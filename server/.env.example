# 对象存储（CDN）账号配置模板
# 用法：复制本文件为 .env，填入真实账号后重启服务。
# ⚠️ .env 已被 .gitignore 忽略，绝不提交到 GitHub。

# S3 兼容 API 域名（结尾不要斜杠）
#   Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
#   阿里云 OSS:    https://oss-cn-hangzhou.aliyuncs.com
#   腾讯云 COS:    https://cos.ap-guangzhou.myqcloud.com
CDN_ENDPOINT=

# 桶名
CDN_BUCKET=

# 区域：R2 填 auto，OSS 填 oss-cn-hangzhou，COS 填 ap-guangzhou
CDN_REGION=auto

# 访问密钥 ID / Secret
CDN_ACCESS_KEY=
CDN_SECRET_KEY=

# 公网读域名（带 https://，结尾不要斜杠）
#   R2 自定义域名: https://cdn.example.com
#   R2 默认域名:   https://pub-xxxx.r2.dev
#   OSS 外网域名:  https://bucket.oss-cn-hangzhou.aliyuncs.com
CDN_PUBLIC_BASE=

# 可选：对象键前缀，如 drama（默认空）
CDN_PATH_PREFIX=
